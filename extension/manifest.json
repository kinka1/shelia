{
  "manifest_version": 3,
  "name": "Shelia MagangHub",
  "version": "1.1.0",
  "description": "Kirim log harian dan ambil token MagangHub dari test-shelia, lewat situs MagangHub sendiri.",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["scripting"],
  "host_permissions": ["https://monev.maganghub.kemnaker.go.id/*", "https://test-shelia.holo.my.id/*"],
  "externally_connectable": { "matches": ["https://test-shelia.holo.my.id/*"] }
}
